# ICLR 2027 figure style (final pass, brief 6.0)
font.family: serif
font.serif: STIXGeneral
mathtext.fontset: stix
font.size: 8
axes.labelsize: 8
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
axes.titlesize: 8
axes.linewidth: 0.6
axes.spines.top: False
axes.spines.right: False
savefig.bbox: tight
pdf.fonttype: 42
# final pass v3 (author's brief, 2026-09-18): Groger/Huh style
axes.grid: True
grid.linestyle: --
grid.color: 0.86
grid.linewidth: 0.5
axes.axisbelow: True
axes.edgecolor: 0.62
xtick.color: black
ytick.color: black
