\section{Methodology}
\label{sec:instrument}

This section fixes what is measured, how it is estimated and normalized, what it is compared with, how depth above the clusters is tested, and how trees are compared across models.

\subsection{Background: Gromov $\delta$}
\label{sec:v3-gromov}

%%GROMOV%%

\begin{definition}[four-point defect]
\label{def:defect}
For a quadruple $(w,x,y,z)$ with the pairing sums of Eq.~\ref{eq:pairings} sorted as $S_{\max}\ge S_{\mathrm{mid}}\ge S_{\min}$, the four-point defect is $\delta(w,x,y,z)=\tfrac12\,(S_{\max}-S_{\mathrm{mid}})$, and the Gromov $\delta$ of a metric space is the supremum of the defect over its quadruples.
\end{definition}

\subsection{Estimation and normalization}
\label{sec:v3-estimation}

%%ESTIMATION%%

\begin{definition}[reading of record]
\label{def:record}
The reading of record of a cloud is $\delta_{\text{norm}}$ of Eq.~\ref{eq:deltanorm}, with $\hat\delta_{99.9}$ computed over half a million sampled quadruples per seed and averaged over ten seeds.
\end{definition}
\begin{proposition}[range bound and dimension confound]
\label{prop:bound}
Let $d_{\min}$ and $d_{\max}$ be the smallest and the largest pairwise distance of a finite metric space. (a) For any quadruple the four-point defect is at most $d_{\max}-d_{\min}$, hence $\delta_{\text{norm}}\le 1-d_{\min}/d_{\max}$. (b) For an iid Gaussian cloud of $n$ points in dimension $d$, $d_{\min}/d_{\max}\to1$ as $d$ grows \citep{beyer1999nearest, aggarwal2001surprising}, so $\delta_{\text{norm}}\to0$ without any structure.
\end{proposition}
\begin{remark}
An anisotropic spectrum changes the effective dimension of the cloud and moves the same bound: the spectrum confound. A supremum over sampled quadruples is a maximum that grows with the sample: the statistic confound.
\end{remark}
The proof is in Appendix~\ref{app:proofs}. The calibration on reference geometries confirms Proposition~\ref{prop:bound} in practice: the estimator recovers the tree zero and the $\ln 2$ constant of the hyperbolic plane, spheres stay high, and iid Gaussians drift down with $d$ (Table~\ref{tab:q10-calibration}).

\subsection{Spectrum-matched null, excess and genuineness}
\label{sec:v3-null}

\begin{definition}[Haar null]
\label{def:null}
Let $X=U\Sigma V^{\top}$ be the singular value decomposition of the centered cloud. A null replicate is $X'=Q\Sigma V^{\top}$ with $Q$ Haar-distributed on the orthogonal group, so $X'$ has the singular values of $X$ and structureless coefficients.
\end{definition}
In plain words, the null is a cloud with the same shape as the real one and no structure inside it. Gaussian coefficients reproduce the spectrum only in expectation, fall short of it when $n$ is small relative to $d$, and inflate the excess of low-rank clouds. The Haar construction reproduces the sample spectrum exactly, so it is the record, and the Gaussian reading is reported alongside it in Table~\ref{tab:q1-census}.

\paragraph{Excess, rank and genuineness.}
\begin{definition}[excess]
\label{def:excess}
With $K$ null replicates $X'_1,\dots,X'_K$ of Definition~\ref{def:null}, the excess of a cell is
\begin{equation}
e(X)=\delta_{\text{norm}}(X)-\frac{1}{K}\sum_{k=1}^{K}\delta_{\text{norm}}(X'_k).
\label{eq:excess}
\end{equation}
\end{definition}
The primary evidence is the rank of the reading among its replicates and the left-tail $p$ that the rank gives,
\begin{equation}
r=\#\{k:\ \delta_{\text{norm}}(X'_k)>\delta_{\text{norm}}(X)\},\qquad p=\frac{1+K-r}{K+1},\qquad K=200.
\label{eq:rank}
\end{equation}
\begin{definition}[genuine]
\label{def:genuine}
Order the $m$ left-tail $p$-values of a census as $p_{(1)}\le\dots\le p_{(m)}$. A cell is genuine when its $p$ is at or below the Benjamini--Hochberg threshold at level five per cent,
\begin{equation}
p\ \le\ p_{(i^{*})},\qquad i^{*}=\max\{i:\ p_{(i)}\le 0.05\, i/m\},
\label{eq:bh}
\end{equation}
and the word is used in this sense only.
\end{definition}
A negative genuine excess certifies clustered structure. The word tree-like is reserved for the depth test of Section~\ref{sec:v3-depthtest}. A positive excess means less tree-like than chance given the spectrum. Figure~\ref{fig:overview} shows the two readings together: in panel (a) the null of each ImageNet backbone moves with its dimension inside a band of two null spreads, as Proposition~\ref{prop:bound}b predicts, so the gap between the filled and the hollow marker, not the level of the filled one, is the reading; in panel (b) two cells with the same raw reading receive opposite verdicts, because one null sits at the reading and the other far above it. % exp1_delta_controls.csv, expR52_census_haar_p999_200.csv, expR62_samplelevel_record.csv

