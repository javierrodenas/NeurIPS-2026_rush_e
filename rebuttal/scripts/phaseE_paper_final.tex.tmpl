\section{Methodology}
\label{sec:instrument}

\subsection{Background: Gromov $\delta$}
\label{sec:f-gromov}

%%GROMOV%%

\begin{definition}[four-point defect]
\label{def:defect}
For a quadruple $(w,x,y,z)$ with the pairing sums of Eq.~\ref{eq:pairings} sorted as $S_{\max}\ge S_{\mathrm{mid}}\ge S_{\min}$, the four-point defect is $\delta(w,x,y,z)=\tfrac12\,(S_{\max}-S_{\mathrm{mid}})$, and the Gromov $\delta$ of a metric space is the supremum of the defect over its quadruples.
\end{definition}

\subsection{Estimation and normalization}
\label{sec:f-estimation}

%%ESTIMATION%%

\begin{definition}[reading of record]
\label{def:record}
The reading of record of a cloud is $\delta_{\text{norm}}$ of Eq.~\ref{eq:deltanorm}, with $\hat\delta_{99.9}$ computed over half a million sampled quadruples per seed and averaged over ten seeds.
\end{definition}

\begin{proposition}[range bound and dimension confound]
\label{prop:bound}
Let $d_{\min}$ and $d_{\max}$ be the smallest and the largest pairwise distance of a finite metric space. (a) For any quadruple the four-point defect is at most $d_{\max}-d_{\min}$, hence $\delta_{\text{norm}}\le 1-d_{\min}/d_{\max}$. (b) For an iid Gaussian cloud of $n$ points in dimension $d$, $d_{\min}/d_{\max}\to1$ as $d$ grows \citep{beyer1999nearest, aggarwal2001surprising}, so $\delta_{\text{norm}}\to0$ without any structure.
\end{proposition}

\paragraph{A structureless cloud reads low.} Proposition~\ref{prop:bound}, proved in Appendix~\ref{app:proofs}, says that a high-dimensional cloud with no structure reads as tree-like. An anisotropic spectrum moves the bound through the effective dimension, and a supremum over sampled quadruples grows with the sample. The calibration on reference geometries confirms this: the estimator recovers the tree zero and the $\ln 2$ of the hyperbolic plane, spheres stay high, and iid Gaussians drift down with the dimension (Table~\ref{tab:q10-calibration}).

\subsection{Spectrum-matched null, excess and genuineness}
\label{sec:f-null}

\begin{definition}[Haar null]
\label{def:null}
Let $X=U\Sigma V^{\top}$ be the singular value decomposition of the centered cloud. A null replicate is $X'=Q\Sigma V^{\top}$ with $Q$ Haar-distributed on the orthogonal group, so $X'$ has the singular values of $X$ and structureless coefficients.
\end{definition}

\paragraph{The null is a cloud with the real shape and no structure.} Gaussian coefficients reproduce the spectrum only in expectation, fall short of it when $n$ is small relative to $d$, and inflate the excess of low-rank clouds. The Haar construction reproduces the sample spectrum exactly, so it is the record. The Gaussian reading is reported beside it (Table~\ref{tab:q1-census}).

\begin{definition}[excess]
\label{def:excess}
With $K$ null replicates $X'_1,\dots,X'_K$ of Definition~\ref{def:null}, the excess of a cell is
\begin{equation}
e(X)=\delta_{\text{norm}}(X)-\frac{1}{K}\sum_{k=1}^{K}\delta_{\text{norm}}(X'_k).
\label{eq:excess}
\end{equation}
\end{definition}

\paragraph{The rank of the reading is the evidence.} The excess is a size. The evidence is the rank of the reading among its replicates and the left-tail $p$ that the rank gives,
\begin{equation}
r=\#\{k:\ \delta_{\text{norm}}(X'_k)>\delta_{\text{norm}}(X)\},\qquad p=\frac{1+K-r}{K+1},\qquad K=200.
\label{eq:rank}
\end{equation}
Rank-based calibration gives the score its finite-sample validity, and a $z$-score is kept only as a secondary summary.

\begin{definition}[genuine]
\label{def:genuine}
Order the $m$ left-tail $p$-values of a census as $p_{(1)}\le\dots\le p_{(m)}$. A cell is genuine when its $p$ is at or below the Benjamini--Hochberg threshold at level five per cent,
\begin{equation}
p\ \le\ p_{(i^{*})},\qquad i^{*}=\max\{i:\ p_{(i)}\le 0.05\, i/m\},
\label{eq:bh}
\end{equation}
and the word is used in this sense only.
\end{definition}

\paragraph{A negative genuine excess means clustered, not tree-like.} A negative genuine excess certifies clustered structure. The word tree-like is reserved for the depth test of Section~\ref{sec:f-depthtest}. The null moves with the dimension, so the reading is the gap between the raw bar and the null, and two cells with the same raw reading can receive opposite verdicts (Figure~\ref{fig:overview}).

