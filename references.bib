@Inbook{Gromov1987,
author="Gromov, M.",
editor="Gersten, S. M.",
title="Hyperbolic Groups",
bookTitle="Essays in Group Theory",
year="1987",
publisher="Springer New York",
address="New York, NY",
pages="75--263",
abstract="Let us start with three equivalent definitions of hyperbolic groups. First observe that for every finitely presented group $\Gamma$ there exists a smooth bounded (i.e. bounded by a smooth hypersurface) connected domain V ⊂ ℝn for every n ≥ 5. such that the fundamental group $\pi$1(V) is isomorphic to $\Gamma$. A standard example of such a V is obtained as follows. Fix a finite presentation of $\Gamma$ and let P be the 2-dimensional cell complex whose 1-cells correspond in the usual way to the generators and the 2-cells to the relations in $\Gamma$, such that $\pi$1(P) = $\Gamma$. Then embed P into ℝ5 and take a regular neighborhood of P ⊂ ℝ5 for V.",
isbn="978-1-4613-9586-7",
doi="10.1007/978-1-4613-9586-7_3",
url="https://doi.org/10.1007/978-1-4613-9586-7_3"
}

